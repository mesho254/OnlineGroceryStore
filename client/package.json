{
  "name": "online-grocery-store",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^1.8.1",
    "@tanstack/react-query": "^5.108.3",
    "axios": "^0.27.2",
    "framer-motion": "^6.3.3",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-is": "^19.3.1",
    "react-redux": "^8.0.1",
    "react-router-dom": "^6.3.0",
    "recharts": "^3.11.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "node ../scripts/clean-vite-cache.mjs && vite",
    "start": "node ../scripts/clean-vite-cache.mjs && vite",
    "build": "vite build",
    "postbuild": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.cpSync('dist', 'build', { recursive: true });\"",
    "preview": "vite preview",
    "check": "node ../scripts/check-codebase.mjs",
    "doctor": "node ../scripts/check-codebase.mjs --fix"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.33.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "vite": "^5.4.11"
  }
}
